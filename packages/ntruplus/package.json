{
  "name": "@killd21/ntruplus",
  "version": "0.1.0",
  "description": "NTRU+ post-quantum key encapsulation (KpqC KEM) for Node.js and browsers, compiled to WebAssembly",
  "keywords": [
    "kpqc",
    "post-quantum",
    "pqc",
    "cryptography",
    "kem",
    "key-encapsulation",
    "ntru",
    "ntruplus",
    "lattice",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "wasm/ntruplus.mjs",
    "wasm/ntruplus.wasm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/killd21/aimer-js.git",
    "directory": "packages/ntruplus"
  },
  "homepage": "https://github.com/killd21/aimer-js/tree/main/packages/ntruplus#readme",
  "bugs": "https://github.com/killd21/aimer-js/issues",
  "publishConfig": {
    "access": "public"
  }
}
